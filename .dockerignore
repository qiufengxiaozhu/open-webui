# ===== 运行时数据（绝对不要打进镜像） =====
backend/data/
backend/open_webui/frontend/
data/
logs/

# ===== 开发依赖 & 构建缓存 =====
node_modules/
.venv/
.svelte-kit/
.cache/
.parcel-cache/
__pycache__/
*.py[cod]
*.egg-info/

# ===== 版本控制 & IDE =====
.git/
.gitignore
.idea/
.vscode/
.cursor/
*.swp
*.swo

# ===== 环境文件（敏感信息） =====
.env
.env.*
!.env.example

# ===== 文档 & 测试（非运行必须） =====
*.md
!docs/skills/*.md
LICENSE
CHANGELOG.md
cypress/
test/
tests/
*.test.*
*.spec.*
htmlcov/
.pytest_cache/
coverage/

# ===== Docker 相关（避免递归） =====
docker-compose*.yml
docker-compose*.yaml

# ===== 日志 & 临时文件 =====
*.log
*.pid
*.seed
.DS_Store
Thumbs.db
*.tmp
*.bak
