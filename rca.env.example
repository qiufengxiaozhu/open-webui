# ============================================================
#  RCA Open WebUI 环境配置文件
#  复制此文件为 rca.env 后修改：cp rca.env.example rca.env
#  docker-compose 会自动加载 rca.env 中的变量
# ============================================================

# ======================== 大模型配置 ========================
# API 地址，多个用分号分隔
# 示例: https://api.openai.com/v1;https://api.minimax.chat/v1
OPENAI_API_BASE_URLS=

# API 密钥，多个用分号分隔（与上面的地址一一对应）
OPENAI_API_KEYS=

# ======================== 安全配置 ========================
# JWT 密钥（生产环境务必修改为随机字符串）
WEBUI_SECRET_KEY=please-change-me-in-production

# 是否启用用户注册认证（true=需要登录，false=匿名访问）
WEBUI_AUTH=true

# ======================== 服务配置 ========================
# 服务端口（容器内部端口）
PORT=9000

# 对外暴露端口（宿主机端口，通过 docker-compose ports 映射）
OPEN_WEBUI_PORT=9000

# 站点名称（显示在页面标题）
WEBUI_NAME=RCA Platform

# 日志级别: DEBUG, INFO, WARNING, ERROR
GLOBAL_LOG_LEVEL=INFO

# Uvicorn worker 数量（默认1，生产环境可增加到 2-4）
UVICORN_WORKERS=1

# ======================== RCA 功能配置 ========================
# 启用 Skills Gate（技能文档路由引擎）
ENABLE_SKILLS_GATE=true

# 技能文档目录（容器内路径，由 docker-compose volumes 挂载）
SKILLS_DIR=/app/docs/skills

# 启用沙箱脚本执行（需要 admin 权限）
ENABLE_SANDBOX_SHELL=false

# 沙箱脚本超时时间（秒）
SANDBOX_TIMEOUT=30

# 沙箱最大输出（字节）
SANDBOX_MAX_OUTPUT=51200

# ======================== 数据库配置 ========================
# 默认使用 SQLite（无需配置），如需 PostgreSQL 取消下方注释
# DATABASE_URL=postgresql://user:password@db:5432/openwebui

# ======================== 隐私配置 ========================
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
